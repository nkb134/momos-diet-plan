---
import Base from '../layouts/Base.astro';
import { planConfig } from '../plan.config';

// Static preview of the day header the chart will use. Numbers are from the
// reference plan's Week 1 Saturday so the look can be judged on real values.
const preview = {
  day: 'Saturday', date: '12 Sep', training: 'Rest',
  macros: [
    { key: 'Protein', value: 144, target: 150, unit: 'g', weight: 'primary' },
    { key: 'Net carbs', value: 116, target: 120, unit: 'g', weight: 'primary' },
    { key: 'Fibre', value: 38, target: 35, unit: 'g', weight: 'secondary' },
    { key: 'Energy', value: 1956, target: 1900, unit: 'kcal', weight: 'secondary' },
  ],
  meals: [
    { slot: 'Breakfast', dish: 'Chana Dal Dhokla with Curd', kcal: 508, protein: 30, diet: 'veg' },
    { slot: 'Lunch', dish: 'Paneer Sabzi Thali with Bhindi and Lauki', kcal: 789, protein: 64, diet: 'veg' },
    { slot: 'Snack', dish: 'Sesame Tofu and Cucumber Salad', kcal: 293, protein: 20, diet: 'veg' },
    { slot: 'Dinner', dish: 'Mushroom Paneer Bhurji', kcal: 365, protein: 30, diet: 'veg' },
  ],
};
---
<Base title="Momo's Diet Plan">
  <main class="mx-auto max-w-3xl px-5 py-16 sm:py-24">
    <header>
      <p class="reveal text-xs font-medium uppercase tracking-[0.18em] text-muted" style="--i:0">
        14 days · starts {new Date(planConfig.startDate + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'long', timeZone: planConfig.timeZone })}
      </p>
      <h1 class="reveal mt-4 text-5xl sm:text-[4.5rem]" style="--i:1">
        Momo's <em class="text-accent">Diet Plan</em>
      </h1>
      <p class="reveal mt-5 max-w-[42ch] text-lg leading-relaxed text-muted" style="--i:2">
        High protein, carb-cycled by training day, fibre-forward, dinners lightest. Every number computed from the ingredient table.
      </p>
    </header>

    <!-- Day header preview -->
    <section class="reveal mt-14" style="--i:3" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="sr-only">Chart preview</h2>
      <div class="overflow-hidden rounded-lg border border-line bg-surface shadow-[0_1px_2px_oklch(0%_0_0/0.04),0_8px_24px_-12px_oklch(0%_0_0/0.12)]">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 px-5 py-4 sm:px-6">
          <div class="flex items-baseline gap-3">
            <span class="font-display text-2xl">{preview.day}</span>
            <span class="text-sm text-muted">{preview.date}</span>
            <span class="rounded-sm border border-line px-1.5 py-0.5 text-xs font-medium uppercase tracking-wider text-muted">{preview.training}</span>
          </div>
          <ul class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Day totals against targets">
            {preview.macros.map((m) => {
              const pct = Math.min(100, Math.round((m.value / m.target) * 100));
              const primary = m.weight === 'primary';
              return (
                <li class="flex items-center gap-2" aria-label={`${m.key} ${m.value} of ${m.target} ${m.unit}`}>
                  <span class:list={['relative block h-1 overflow-hidden rounded-full bg-line', primary ? 'w-16' : 'w-10']} aria-hidden="true">
                    <span class:list={['absolute inset-y-0 left-0 rounded-full', primary ? 'bg-accent' : 'bg-muted']} style={`width:${pct}%`}></span>
                  </span>
                  <span class:list={['tabular-nums', primary ? 'text-sm font-medium' : 'text-xs text-muted']}>
                    {m.value}<span class="text-muted">/{m.target}</span>
                  </span>
                  <span class="text-xs text-muted">{m.key}</span>
                </li>
              );
            })}
          </ul>
        </div>
        <ol class="divide-y divide-line border-t border-line">
          {preview.meals.map((meal) => (
            <li class="group grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1 px-5 py-3.5 transition-colors duration-200 hover:bg-paper sm:flex sm:gap-4 sm:px-6">
              <svg class="size-3.5 shrink-0" viewBox="0 0 16 16" role="img" aria-label={meal.diet === 'veg' ? 'Vegetarian' : 'Non-vegetarian'}>
                <rect x="1" y="1" width="14" height="14" fill="none" stroke={meal.diet === 'veg' ? 'var(--color-veg)' : 'var(--color-nonveg)'} stroke-width="1.5" />
                <circle cx="8" cy="8" r="3.5" fill={meal.diet === 'veg' ? 'var(--color-veg)' : 'var(--color-nonveg)'} />
              </svg>
              <span class="text-xs font-medium uppercase tracking-wider text-muted sm:w-20 sm:shrink-0">{meal.slot}</span>
              <span class="text-sm tabular-nums text-muted sm:order-last sm:shrink-0"><span class="text-ink">{meal.protein} g</span> · {meal.kcal}</span>
              <span class="col-span-2 col-start-2 min-w-0 sm:col-auto sm:flex-1 sm:truncate">{meal.dish}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="mt-3 text-xs text-muted">Preview of the day header. Values are estimates from the ingredient table.</p>
    </section>

    <footer class="reveal rule mt-16 flex flex-wrap items-center justify-between gap-3 pt-5 text-xs text-muted" style="--i:4">
      <span>Milestone 1 · base path <code class="font-mono">{import.meta.env.BASE_URL}</code></span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span class="inline-block size-2.5 rounded-full bg-ink" aria-hidden="true"></span>
        <span class="inline-block size-2.5 rounded-full bg-muted" aria-hidden="true"></span>
        <span class="inline-block size-2.5 rounded-full border border-line bg-surface" aria-hidden="true"></span>
        tokens
      </span>
    </footer>
  </main>
</Base>
