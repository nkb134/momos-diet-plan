---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DayNav from '../components/DayNav.astro';
import Reel from '../components/Reel.astro';
import MacroStrip from '../components/MacroStrip.astro';
import ShoppingList from '../components/ShoppingList.astro';
import { loadPlan, todayIso, formatDate, shoppingList, trainingLabel } from '../lib/plan';
import { planConfig } from '../plan.config';

const { days, table } = await loadPlan();
const today = todayIso();
const inPlan = days.some((d) => d.date === today);
const defaultDate = inPlan ? today : days[0]!.date;
const weeks = [...new Set(days.map((d) => d.week))];
type Slide = { slot: (typeof days)[number]['meals'][number]['slot']; recipe: any; grams: Record<string, number>; macros: any; isAddOn: boolean };
const views = days.map((d) => {
  const slides: Slide[] = [];
  for (const m of d.meals) {
    slides.push({ slot: m.slot, recipe: m.recipe, grams: m.grams, macros: m.macros, isAddOn: false });
    if (m.addOn) slides.push({ slot: m.slot, recipe: m.addOn.recipe, grams: m.addOn.grams, macros: m.addOn.macros, isAddOn: true });
  }
  return { d, slides, list: shoppingList([d], table) };
});
---
<Base title="Momo's Diet Plan">
  <SiteHeader current="chart" />
  <main id="chart" class="pb-20 [--chrome-h:240px] sm:pb-0 sm:[--chrome-h:200px]">
    <div class="hidden sm:block"><DayNav days={days} today={today} /></div>

    {views.map(({ d, slides, list }) => (
        <section class="day mx-auto max-w-5xl px-0 sm:px-4" id={`d-${d.date}`} data-date={d.date} data-week={d.week} hidden={d.date !== defaultDate} aria-label={`${d.day} ${formatDate(d.date)}`}>
          <div class="daybar flex flex-wrap items-end justify-between gap-x-6 gap-y-1.5 px-4 py-2 sm:py-3 sm:px-0">
            <div class="flex items-baseline gap-2.5">
              <h1 class="font-display text-2xl leading-none">{d.day}</h1>
              <span class="text-sm text-muted">{formatDate(d.date)}</span>
              <span class="rounded-full border border-line bg-surface px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider text-muted" title="Sets today's net-carb ceiling">{trainingLabel[d.training]}</span>
              {d.date === today && <span class="rounded-full bg-accent px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider text-ink">Today</span>}
            </div>
            <div class="flex items-center gap-3">
              <MacroStrip items={[
                { key: 'Protein', value: d.totals.protein_g, target: d.targets.protein_g, unit: 'g', primary: true },
                { key: 'Net carbs', value: d.totals.netCarbs_g, target: d.targets.netCarbs_g[1], range: d.targets.netCarbs_g, unit: 'g', primary: true },
                { key: 'Fibre', value: d.totals.fibre_g, target: d.targets.fibre_g, unit: 'g' },
                { key: 'kcal', value: d.totals.kcal, target: d.targets.kcal, unit: 'kcal' },
              ]} />
              <button type="button" class="grid size-10 place-items-center rounded-full border border-line hover:bg-surface sm:h-9 sm:w-auto sm:px-3 sm:text-xs" data-open={`shop-${d.date}`} aria-label="Shopping list for this day"><svg class="size-4 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg><span class="hidden sm:inline">Shopping list</span></button>
            </div>
          </div>
          <Reel id={`reel-${d.date}`} slides={slides} table={table} dayDate={d.date} eagerFirst={d.date === defaultDate} />
          <ShoppingList id={`shop-${d.date}`} title={`${d.day} ${formatDate(d.date)}`} list={list} note="Quantities cook every veg dish for 2 and each add-on for 1." links={weeks.map((w) => ({ id: `shop-week-${w}`, label: `Week ${w} list` }))} />
        </section>
    ))}

    {weeks.map((w) => (
      <ShoppingList id={`shop-week-${w}`} title={`Week ${w} shopping list`} list={shoppingList(days.filter((d) => d.week === w), table)} note="Seven days. Veg dishes for 2, add-ons for 1." />
    ))}
    <div class="mx-auto hidden max-w-5xl flex-wrap gap-2 px-4 py-4 text-xs text-muted sm:flex">
      {weeks.map((w) => <button type="button" class="rounded-full border border-line px-3 py-1 hover:bg-surface" data-open={`shop-week-${w}`}>Week {w} shopping list</button>)}
      <span class="ml-auto self-center">Plan starts {formatDate(planConfig.startDate, { day: 'numeric', month: 'long' })} · all figures are estimates</span>
    </div>
    <div class="sm:hidden"><DayNav days={days} today={today} /></div>
  </main>

  <script>
    function init() {
      const sections = [...document.querySelectorAll<HTMLElement>('section.day')];
      if (!sections.length) return;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('.daybtn')];
      const dates = sections.map((s) => s.dataset.date!);
      const pick = (): string => {
        const h = location.hash.replace('#', '');
        if (dates.includes(h)) return h;
        try { const s = localStorage.getItem('day'); if (s && dates.includes(s)) return s; } catch {}
        return sections.find((s) => !s.hidden)?.dataset.date ?? dates[0]!;
      };
      const chart = document.getElementById('chart')!;
      const measure = () => {
        // Reel height = viewport minus everything above the reel and any fixed bar below it.
        const frame = document.querySelector<HTMLElement>('section.day:not([hidden]) .reel-frame');
        if (!frame) return;
        const above = frame.getBoundingClientRect().top + scrollY;
        const fixedNav = [...document.querySelectorAll<HTMLElement>('.daynav')].filter((n) => getComputedStyle(n).position === 'fixed').reduce((a, n) => a + n.getBoundingClientRect().height, 0);
        chart.style.setProperty('--chrome-h', `${Math.round(above + fixedNav)}px`);
      };
      const show = (date: string, push = false) => {
        for (const s of sections) s.hidden = s.dataset.date !== date;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.date === date));
        buttons.find((b) => b.dataset.date === date && b.offsetParent)?.scrollIntoView({ inline: 'center', block: 'nearest' });
        try { localStorage.setItem('day', date); } catch {}
        measure(); requestAnimationFrame(measure);
        if (push) history.replaceState(null, '', `#${date}`);
        // let lazy images inside the newly shown reel start loading
        document.getElementById(`reel-${date}`)?.querySelector('.reel')?.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
      };
      buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.date!, true)));
      new ResizeObserver(measure).observe(document.body);
      addEventListener('resize', measure);
      addEventListener('hashchange', () => show(pick()));
      document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => b.addEventListener('click', () => (document.getElementById(b.dataset.open!) as HTMLDialogElement)?.showModal()));
      show(pick());
    }
    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Base>
