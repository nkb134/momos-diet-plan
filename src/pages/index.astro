---
import Base from '../layouts/Base.astro';
import Reel from '../components/Reel.astro';
import MealSlide from '../components/MealSlide.astro';
import { planConfig } from '../plan.config';

const startLabel = new Date(planConfig.startDate + 'T00:00:00').toLocaleDateString('en-IN', {
  day: 'numeric', month: 'short', timeZone: planConfig.timeZone,
});

// Static preview of Week 1, Saturday. Ingredient grams are the seed values
// with the plan's portion and anchorGrams applied; macros are from the
// reference plan. All of this becomes collection-driven in milestone 2.
const day = {
  name: 'Saturday', training: 'Rest day',
  totals: [
    { key: 'Protein', value: 144, target: 150, unit: 'g' },
    { key: 'Net carbs', value: 116, target: 120, unit: 'g' },
    { key: 'Fibre', value: 38, target: 35, unit: 'g' },
    { key: 'Energy', value: 1956, target: 1900, unit: 'kcal' },
  ],
  meals: [
    { slot: 'Breakfast', slug: 'chana-dhokla-curd', dish: 'Chana Dal Dhokla with Curd', minutes: 35, diet: 'veg' as const,
      macros: [{ key: 'Protein', value: 30, target: 35, unit: 'g' }, { key: 'Net carbs', value: 37, target: 40, unit: 'g' }, { key: 'Fibre', value: 10, target: 8, unit: 'g' }, { key: 'Energy', value: 508, target: 500, unit: 'kcal' }],
      ingredients: [{ name: 'Toned curd', grams: 178 }, { name: 'Hung curd', grams: 115 }, { name: 'Chana dal', grams: 49 }, { name: 'Flaxseed', grams: 9 }, { name: 'Coriander', grams: 9 }, { name: 'Green chilli', grams: 4 }] },
    { slot: 'Lunch', slug: 'paneer-sabzi-thali', dish: 'Paneer Sabzi Thali with Bhindi and Lauki', minutes: 40, diet: 'veg' as const,
      macros: [{ key: 'Protein', value: 64, target: 50, unit: 'g' }, { key: 'Net carbs', value: 53, target: 55, unit: 'g' }, { key: 'Fibre', value: 15, target: 12, unit: 'g' }, { key: 'Energy', value: 789, target: 700, unit: 'kcal' }],
      ingredients: [{ name: 'Greek curd', grams: 221 }, { name: 'Bhindi', grams: 148 }, { name: 'Lauki', grams: 148 }, { name: 'Low-fat paneer', grams: 140 }, { name: 'Cucumber', grams: 74 }, { name: 'Jowar flour', grams: 31 }] },
    { slot: 'Snack', slug: 'tofu-cucumber-salad', dish: 'Sesame Tofu and Cucumber Salad', minutes: 15, diet: 'veg' as const,
      macros: [{ key: 'Protein', value: 20, target: 25, unit: 'g' }, { key: 'Net carbs', value: 11, target: 20, unit: 'g' }, { key: 'Fibre', value: 7, target: 5, unit: 'g' }, { key: 'Energy', value: 293, target: 300, unit: 'kcal' }],
      ingredients: [{ name: 'Tofu', grams: 195 }, { name: 'Cucumber', grams: 80 }, { name: 'Cabbage', grams: 48 }, { name: 'Carrot', grams: 32 }, { name: 'Flaxseed', grams: 8 }, { name: 'Sesame', grams: 6 }] },
    { slot: 'Dinner', slug: 'mushroom-paneer-bhurji', dish: 'Mushroom Paneer Bhurji', minutes: 20, diet: 'veg' as const,
      macros: [{ key: 'Protein', value: 30, target: 45, unit: 'g' }, { key: 'Net carbs', value: 14, target: 25, unit: 'g' }, { key: 'Fibre', value: 6, target: 10, unit: 'g' }, { key: 'Energy', value: 365, target: 600, unit: 'kcal' }],
      ingredients: [{ name: 'Mushroom', grams: 120 }, { name: 'Low-fat paneer', grams: 105 }, { name: 'Tomato', grams: 40 }, { name: 'Capsicum', grams: 40 }, { name: 'Onion', grams: 32 }, { name: 'Coriander', grams: 8 }] },
  ],
};
---
<Base title="Momo's Diet Plan">
  <main class="[--bar-h:64px]">
    <!-- day bar -->
    <header class="reveal mx-auto flex h-[var(--bar-h)] max-w-5xl items-center justify-between gap-4 px-5" style="--i:0">
      <div class="flex items-baseline gap-2.5">
        <h1 class="font-display text-2xl">{day.name}</h1>
        <span class="whitespace-nowrap text-sm text-muted">{startLabel}</span>
        <span class="hidden rounded-full border border-line bg-surface px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-muted sm:inline">{day.training}</span>
      </div>
      <ul class="flex gap-x-4" aria-label="Day totals against targets">
        {day.totals.map((m, i) => (
          <li class:list={['flex flex-col items-end leading-tight tabular-nums', i > 1 && 'hidden sm:flex']} aria-label={`${m.key} ${m.value} of ${m.target} ${m.unit}`}>
            <span class:list={['whitespace-nowrap text-sm', i < 2 ? 'font-medium' : 'text-muted']}>{m.value}<span class="font-normal text-muted">/{m.target}</span></span>
            <span class="whitespace-nowrap text-[11px] uppercase tracking-wider text-muted">{m.key}</span>
          </li>
        ))}
      </ul>
    </header>

    <div class="reveal" style="--i:1">
      <Reel count={day.meals.length}>
        {day.meals.map((meal, i) => (
          <MealSlide index={i} total={day.meals.length} {...meal} />
        ))}
      </Reel>
    </div>
  </main>
</Base>
